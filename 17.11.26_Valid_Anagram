class Solution {
public:
    bool isAnagram(string s, string t) 
    {
        int f[266]={0};
        if(s.size()-t.size()!=0)
        return false;
        for(int i=0;s[i];i++)
        {
            f[s[i]]++;
            f[t[i]]--;
        }
        
        for(int i=0;s[i];i++)
        {
            if(f[s[i]]!=0)
            {
                return false;
            }
        }
        return true;
    }
};
