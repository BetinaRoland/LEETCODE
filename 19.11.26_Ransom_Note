class Solution {
public:
    bool canConstruct(string ransomNote, string magazine) 
    {
        int f[266]={0};

        for(int i=0;ransomNote[i];i++)
        f[ransomNote[i]]++;    

        for(int i=0;magazine[i];i++)
        f[magazine[i]]--; 

        for(int i=0;i<ransomNote[i];i++)
        {
            if(f[ransomNote[i]]>0)
            return false;
        }

        return true;
    }
};
