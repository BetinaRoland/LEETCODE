class Solution {
public:
    ListNode* mergeTwoLists(ListNode* list1, ListNode* list2) 
    {
        if(list1 == NULL)
            return list2;
        else if(list2 == NULL)
            return list1;

        ListNode *h, *t;

        if(list1->val > list2->val)
        {
            h = list2;
            list2 = list2->next;
        }
        else
        {
            h = list1;
            list1 = list1->next;
        }

        t = h;

        while(list1 != NULL && list2 != NULL)
        {
            if(list1->val < list2->val)
            {
                t->next = list1;
                list1 = list1->next;
            }
            else
            {
                t->next = list2;
                list2 = list2->next;
            }
            t = t->next;
        }

        if(list1 != NULL)
            t->next = list1;
        else
            t->next = list2;

        return h;
    }
};
