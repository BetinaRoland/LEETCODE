class Solution {
public:
    int pivotIndex(vector<int>& nums) 
    {
        int i,k=0;

        for(i=0;i<nums.size();i++)
        {
            k+=nums[i];
        }  
        int y=0;
        for(i=0;i<nums.size();i++)
        {
            k-=nums[i];
            if(k==y) return i;
            y+=nums[i];
        }   

        return -1;   
    }
};
