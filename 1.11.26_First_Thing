class Solution {
public:
    int mySqrt(int x) 
    {
        int l=0,r=x,m;

        if(x==0)
        return 0;
        if(x==1)
        return 1;

        while(l<=r)
        {
            m=(l+r)/2;

            if((long)m*m<(long)x)
            l=m+1;
            else if((long)m*m>(long)x)
            r=m-1;
            else
            return m;
        }        
        return r;
    }
};
